{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codesk",
  "version": "0.2.2",
  "identifier": "app.codesk.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm run build && pnpm run build:gateway && pnpm run build:daemon",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codesk",
        "width": 1800,
        "height": 1050,
        "minWidth": 980,
        "minHeight": 680,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/codesk-gateway": "bin/codesk-gateway",
      "binaries/codeskd": "bin/codeskd"
    }
  }
}
