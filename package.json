{
  "name": "codesk",
  "private": true,
  "version": "0.2.2",
  "description": "Open-source control plane for coding agents, local or remote.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dat-lequoc/codesk.git"
  },
  "bugs": {
    "url": "https://github.com/dat-lequoc/codesk/issues"
  },
  "homepage": "https://github.com/dat-lequoc/codesk",
  "type": "module",
  "bin": {
    "codesk": "bin/codesk.mjs"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bench:codex": "cargo build -p codeskd && node scripts/bench-codex-runtime.mjs",
    "build": "vite build",
    "build:daemon": "node scripts/build-daemon.mjs",
    "build:gateway": "node scripts/build-gateway.mjs",
    "check": "tsc --noEmit && eslint src",
    "desktop": "tauri dev",
    "desktop:build": "pnpm run build:gateway && pnpm run build:daemon && tauri build",
    "desktop:handoff": "pnpm run desktop:redeploy",
    "desktop:redeploy": "node scripts/redeploy-local.mjs",
    "dev": "concurrently -k -n api,ui -c cyan,magenta \"node --watch server/index.mjs\" \"vite\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "lint": "eslint src",
    "start:web": "CODESK_WEB_MODE=1 node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:agy-live": "cargo build -p codeskd && node scripts/test-agy-live.mjs",
    "test:backend": "cargo build -p codeskd && cargo test -p codeskd && node scripts/test-session-budget.mjs && node scripts/test-turn-completion.mjs && node scripts/test-daemon-upgrade.mjs && node scripts/test-run-archive.mjs && node scripts/test-hidden-agents.mjs && node scripts/test-codex-app-server.mjs && node scripts/test-gateway-codex.mjs && node scripts/test-daemon-survival.mjs && node scripts/test-daemon-lifecycle.mjs && node scripts/test-gateway-origin.mjs && node scripts/test-worktrees.mjs && node scripts/test-discovery.mjs && node scripts/test-drafts.mjs && node scripts/test-host-bootstrap-retry.mjs && node scripts/test-mappers.mjs",
    "test:bootstrap-live": "node scripts/test-remote-bootstrap-live.mjs",
    "test:coverage": "vitest run --coverage",
    "test:dsh-live": "node scripts/test-dsh-live.mjs",
    "test:claude-completion-live": "cargo build -p codeskd && node scripts/test-claude-completion-live.mjs",
    "test:claude-tmux-live": "cargo build -p codeskd && node scripts/test-claude-tmux-live.mjs",
    "test:codex-model-live": "cargo build -p codeskd && node scripts/test-codex-model-live.mjs",
    "test:kiro-live": "cargo build -p codeskd && node scripts/test-kiro-acp-live.mjs",
    "test:kiro-model-live": "cargo build -p codeskd && node scripts/test-kiro-model-live.mjs",
    "test:kiro-tmux-live": "cargo build -p codeskd && node scripts/test-kiro-tmux-live.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/plugin-notification": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "3.3.1",
    "tw-animate-css": "1.4.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^9.2.0",
    "eslint": "9.38.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.0",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.46.0",
    "vite": "^7.1.2",
    "vitest": "4.1.11"
  }
}
